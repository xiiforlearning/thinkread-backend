BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TZ=Asia/Tashkent

# Local docker-compose: use these individual vars (bot connects to the postgres service).
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=bot
DATABASE_PASSWORD=bot
DATABASE_NAME=thinkread

# Managed hosting (Railway / Neon / Supabase / etc.): set DATABASE_URL instead.
# It overrides the individual DATABASE_* vars above.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true

NODE_ENV=development

# Set to false to boot without Telegram polling (boot checks, CI, API-only runs).
BOT_LAUNCH=true

# REST API for the Mini App and the dashboard.
JWT_SECRET=
# WEBAPP_URL=https://app.thinkread.uz
# CORS_ORIGINS=https://app.thinkread.uz

# Claude API (report parsing, word enrichment, authenticity checks, teacher chat).
# Leave the key empty (or set AI_MODE=fake) to run on the rule-based stub: no tokens spent,
# every AI feature works with deterministic output. AI_MODE=anthropic forces the real API.
ANTHROPIC_API_KEY=
# AI_MODE=fake
# AI_MODEL_DIALOG=claude-haiku-4-5
# AI_MODEL_AUTHENTICITY=claude-haiku-4-5
