BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TZ=Asia/Tashkent

# Local docker-compose: use these individual vars (bot connects to the postgres service).
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=bot
DATABASE_PASSWORD=bot
DATABASE_NAME=thinkread

# Managed hosting (Railway / Neon / Supabase / etc.): set DATABASE_URL instead.
# It overrides the individual DATABASE_* vars above.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=true

NODE_ENV=development

# Set to false to boot without Telegram polling (boot checks, CI, API-only runs).
BOT_LAUNCH=true

# REST API for the Mini App and the dashboard.
JWT_SECRET=
# WEBAPP_URL=https://app.thinkread.uz
# CORS_ORIGINS=https://app.thinkread.uz
# Dashboard "Log in with Telegram": BotFather's Client ID for the bot. Default: the bot id
# (the number before ":" in BOT_TOKEN) — set only if BotFather shows a different Client ID.
# TELEGRAM_LOGIN_CLIENT_ID=
# Client secret from the same BotFather screen; optional — set it if Telegram refuses the code
# exchange without it ("invalid_client" in the logs).
# TELEGRAM_LOGIN_CLIENT_SECRET=

# Claude API (report parsing, word enrichment, authenticity checks, teacher chat).
# AI_MODE picks who answers: anthropic (the API, needs the key), claude-cli (the Claude Code CLI
# installed and signed in on this machine — no key, for development and demos), fake (rule-based
# stub, deterministic, used in CI). Without a key and without AI_MODE the app runs on fake.
ANTHROPIC_API_KEY=
# AI_MODE=claude-cli
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_MODEL=haiku
# CLAUDE_CLI_TIMEOUT_MS=120000
# AI_MODEL_DIALOG=claude-haiku-4-5
# AI_MODEL_AUTHENTICITY=claude-haiku-4-5
