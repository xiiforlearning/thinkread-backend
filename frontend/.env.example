# Base URL of the ThinkRead REST API (no trailing slash). Empty = same origin.
VITE_API_URL=http://localhost:3000
# "1" — run on in-memory demo data without a backend (for showing the UI).
# Outside Telegram the app also falls back to demo mode automatically.
VITE_DEMO=0
# Bot username for the dashboard's Telegram Login Widget (without @).
VITE_BOT_USERNAME=
